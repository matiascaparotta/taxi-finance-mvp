{
  "name": "taxi-finance",
  "private": true,
  "version": "1.0.0-beta",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "install:all": "npm ci --prefix server && npm ci --prefix client",
    "build": "VITE_API_URL=/api npm run build --prefix client",
    "db:backup": "npm run db:backup --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "start": "NODE_ENV=production npm start --prefix server",
    "test": "npm test --prefix server && npm test --prefix client"
  }
}
